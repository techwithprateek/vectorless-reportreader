# .env.example
# -------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ReportReader uses LiteLLM to route to any LLM provider.
# Set LLM_MODEL to the model you want to use (see options below).
# The tree indexing and Q&A both use the same model.


# ---------------------------------------------------------------------------
# OPTION 1 — OpenAI (recommended for best accuracy)
# ---------------------------------------------------------------------------
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-openai-key-here


# ---------------------------------------------------------------------------
# OPTION 2 — Anthropic Claude
# Comment out Option 1 and uncomment these lines.
# ---------------------------------------------------------------------------
# LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here


# ---------------------------------------------------------------------------
# OPTION 3 — Ollama (local, free, no API key needed)
# Start Ollama first: ollama run llama3.2
# Then uncomment these lines.
# ---------------------------------------------------------------------------
# LLM_MODEL=ollama/llama3.2
# OLLAMA_BASE_URL=http://localhost:11434


# ---------------------------------------------------------------------------
# OPTION 4 — Any other LiteLLM-supported provider
# See https://docs.litellm.ai/docs/providers for full list
# Examples: mistral, groq, azure, bedrock, together_ai ...
# ---------------------------------------------------------------------------
# LLM_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=your-groq-key-here


